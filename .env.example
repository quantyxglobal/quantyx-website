# Dashboard URL for login integration
# Development: http://localhost:3000/login
# Production: https://your-dashboard-domain.com/login
VITE_DASHBOARD_URL=http://localhost:3000/login

# AWS Configuration (from dashboard)
# Use the same AWS credentials as the dashboard
VITE_AWS_ACCESS_KEY_ID=your-aws-access-key
VITE_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
VITE_AWS_REGION=ap-south-2
VITE_AWS_S3_BUCKET_NAME=quantyx-global

# Email Configuration (from dashboard)
VITE_SES_REGION=us-east-1
VITE_SUPPORT_EMAIL=support@quantxg.com
