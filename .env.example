# Dashboard URL for API integration
VITE_DASHBOARD_URL=https://your-dashboard-url.amplifyapp.com

# AWS Configuration (S3 only - for file storage)
# IMPORTANT: Never commit actual credentials to git
# Set these in your hosting platform's environment variables
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key_here
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
VITE_AWS_REGION=ap-south-2
VITE_AWS_S3_BUCKET_NAME=your-bucket-name

# Postmark Email Configuration
VITE_POSTMARK_SERVER_TOKEN=your_postmark_token_here
VITE_SUPPORT_EMAIL=support@yourdomain.com
