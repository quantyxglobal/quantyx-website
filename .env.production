# Firebase Production Environment Variables for Website
# These are injected at BUILD TIME (prefix with VITE_)

# AWS S3 Configuration (for file storage)
VITE_AWS_S3_BUCKET=quantyx-global
VITE_AWS_REGION=ap-south-2
VITE_AWS_ACCESS_KEY_ID=your-access-key-id
VITE_AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Supabase Configuration
VITE_SUPABASE_URL=https://wghvermnyvppsgshgbmu.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Endpoints
VITE_API_BASE_URL=https://dashboard.quantyxg.com/api
VITE_WEBSITE_URL=https://quantyxg.com

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHAT=false

# Contact Form
VITE_CONTACT_EMAIL=info@quantyxg.com

# Route53 Custom Domain
VITE_DOMAIN=quantyxg.com
