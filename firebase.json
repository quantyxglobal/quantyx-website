{
  "hosting": {
    "site": "quantyx-website",
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.test.*",
      "**/test/**"
    ],
    "frameworksBackend": {
      "region": "us-east4",
      "memory": "1GiB",
      "minInstances": 0,
      "maxInstances": 5,
      "concurrency": 80,
      "cpu": 1,
      "timeoutSeconds": 60
    }
  }
}
