{
  "hosting": {
    "site": "quantyx-website",
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.test.*",
      "**/test/**"
    ],
    "redirects": [
      {
        "source": "https://quantyxg.com",
        "destination": "https://www.quantyxg.com",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**/*!([^.])@(.|)!(.@(css|gif|ico|jpg|jpeg|js|png|txt|svg|woff|woff2|ttf|map|json))$([A-z]\\{1\\})/:**",
        "destination": "/index.html"
      },
      {
        "source": "/<*>",
        "destination": "/index.html"
      }
    ],
    "frameworksBackend": {
      "region": "us-east4",
      "memory": "1GiB",
      "minInstances": 0,
      "maxInstances": 5,
      "concurrency": 80,
      "cpu": 1,
      "timeoutSeconds": 60
    }
  }
}
